# ==============================================================================
# COGENT MARKETING SHIELD - ENVIRONMENT VARIABLES SPECIFICATION
# Phase 1: Engineering Environment & CI/CD Baseline
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "true" during CI/CD or docker build steps where secrets are injected later
SKIP_ENV_VALIDATION=false

# ------------------------------------------------------------------------------
# 1. Clerk Authentication & Multi-Tenancy (Phase 3)
# https://dashboard.clerk.com
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL & pgvector Engine (Phase 2)
# https://supabase.com/dashboard/project/.../settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. Cloudflare R2 Private Object Storage (Phase 4)
# https://dash.cloudflare.com/ -> R2 -> Manage R2 API Tokens
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=cogent-compliance-production
# Optional public CDN prefix if custom domain is bound:
# R2_PUBLIC_URL_PREFIX=https://r2.yourdomain.com

# ------------------------------------------------------------------------------
# 4. Google Gemini API (@google/genai SDK) (Phase 5)
# https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 5. Inngest Durable Async Workflows & Crons (Phase 5)
# https://app.inngest.com
# ------------------------------------------------------------------------------
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=signkey-prod-...

# ------------------------------------------------------------------------------
# 6. Better Stack Observability & Logs (Phase 1)
# https://telemetry.betterstack.com / https://betteruptime.com
# ------------------------------------------------------------------------------
BETTER_STACK_LOGTAIL_SOURCE_TOKEN=your_better_stack_source_token
BETTER_STACK_UPTIME_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/...

# ------------------------------------------------------------------------------
# 7. Resend Transactional Email Alerts (Phase 4)
# https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=compliance@notifications.cogentshield.com

# ------------------------------------------------------------------------------
# 8. Paystack Dual-Currency Billing & Webhooks (Document 11)
# https://dashboard.paystack.com/#/settings/developers
# ------------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_...

# Owner-only Internal Workspace (unlimited Enterprise for demos, walkthroughs & marketing; no Paystack)
# Set ONLY in Vercel "Production" and "Preview" scopes. It is ignored locally (requires VERCEL_ENV=production|preview).
# Must be a VERIFIED email on your Clerk user.
PLATFORM_OWNER_EMAIL=
# Optional extra pin: your Clerk user ID (user_...). Differs between Clerk dev/prod instances, so scope per environment.
PLATFORM_OWNER_CLERK_USER_ID=

# ------------------------------------------------------------------------------
# 9. Dual-Engine Nigeria & Africa Regulatory Web Search (Document 14 & 15)
# ------------------------------------------------------------------------------
EXA_API_KEY=exa_...
SERPAPI_API_KEY=serpapi_...
LIVE_WEB_INTERACTIVE_TIMEOUT_MS=3500
LIVE_WEB_CACHE_TTL_HOURS=12
ENABLE_DUAL_LIVE_WEB_SEARCH=true
