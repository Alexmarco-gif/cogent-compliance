  "private": true,
  "description": "Cogent Marketing Shield - Standalone Enterprise Regulatory & Marketing Compliance Operating System",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
