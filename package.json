    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@clerk/nextjs": "^7.9.25",
    "@google/genai": "^3.1.0",
    "@logtail/node": "^0.6.1",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "inngest": "^4.26.2",
    "lucide-react": "^0.475.0",
    "next": "15.5.29",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^6.38.0",
    "svix": "^2.10.0",
    "tailwind-merge": "^3.0.1",
    "unpdf": "^2.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
